<Window x:Class="PaintOverlay.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PaintOverlay"
        mc:Ignorable="d"
        Title="PreferencesWindow" Height="450" Width="800"
        KeyDown="Window_KeyDown">
    <StackPanel Margin="10,0,10,0">
        <Label x:Name="preferences_label" Content="Key Bindings" FontSize="24" />
        <Separator Background="Gray" Height="2"/>
        <Grid Margin="0,10,0,20" x:Name="preferences_grid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <TextBlock Text="Toggle Canvas Visibility" Grid.Row="0" Grid.Column="0"/>
            <TextBlock Text="Toggle Menu Visiblity" Grid.Row="1"/>

            <Button Name="Canvas_Visibility_Bind" Grid.Column="1" Click="Visibility_Bind_Click"/>
            <Button Name="Menu_Visibility_Bind" Grid.Column="1" Grid.Row="1" Click="Visibility_Bind_Click"/>

            <Button Name="Canvas_Visibility_Reset" Content="Reset" Grid.Column="2" Click="Visibility_Reset_Click"/>
            <Button Name="Menu_Visibility_Reset" Content="Reset" Grid.Column="2" Grid.Row="2" Click="Visibility_Reset_Click"/>

        </Grid>
        <Button HorizontalAlignment="Right" Content="Restore All Defaults" Margin="5" Click="Restore_Default" />
    </StackPanel>
</Window>
