<Window x:Class="PaintOverlay.ColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PaintOverlay"
        mc:Ignorable="d"
        Title="ColorWindow" Height="400" Width="400">
    <StackPanel Margin="10,0,10,0">
        <Label Content="Select Brush Color" FontSize="24"/>
        <Separator Background="Gray"/>
        <Grid Margin="0,10,0,10" x:Name="ColorGrid" Height="150">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Rectangle Stroke="Black"/>
            <Rectangle Fill="Black" Grid.Column="1"/>
            <Rectangle Fill="Red" Stroke="Black" Grid.Column="2"/>
            <Rectangle Fill="Blue" Stroke="Black" Grid.Column="3"/>
            <Rectangle Fill="Yellow" Stroke="Black" Grid.Column="4"/>
            <Rectangle Fill="Green" Stroke="Black" Grid.Column="5"/>
            <Rectangle Fill="Purple" Stroke="Black" Grid.Column="6"/>
            <Rectangle Fill="Orange" Stroke="Black" Grid.Column="7"/>

            <Rectangle Fill="Pink" Stroke="Black" Grid.Row="1"/>
            <Rectangle Fill="Gold" Stroke="Black" Grid.Row="1" Grid.Column="1"/>
            <Rectangle Fill="Gray" Stroke="Black" Grid.Row="1" Grid.Column="2"/>
            <Rectangle Fill="LightGray" Stroke="Black" Grid.Row="1" Grid.Column="3"/>
            <Rectangle Fill="Maroon" Stroke="Black" Grid.Row="1" Grid.Column="4"/>
            <Rectangle Fill="DeepSkyBlue" Stroke="Black" Grid.Row="1" Grid.Column="5"/>
            <Rectangle Fill="HotPink" Stroke="Black" Grid.Row="1" Grid.Column="6"/>
            <Rectangle Fill="LawnGreen" Stroke="Black" Grid.Row="1" Grid.Column="7"/>

            <Rectangle Fill="MediumVioletRed" Stroke="Black" Grid.Row="2"/>
            <Rectangle Fill="MediumPurple" Stroke="Black" Grid.Row="2" Grid.Column="1"/>
            <Rectangle Fill="Navy" Stroke="Black" Grid.Row="2" Grid.Column="2"/>
            <Rectangle Fill="DarkGoldenrod" Stroke="Black" Grid.Row="2" Grid.Column="3"/>
            <Rectangle Fill="SaddleBrown" Stroke="Black" Grid.Row="2" Grid.Column="4"/>
            <Rectangle Fill="PaleGreen" Stroke="Black" Grid.Row="2" Grid.Column="5"/>
            <Rectangle Fill="BlanchedAlmond" Stroke="Black" Grid.Row="2" Grid.Column="6"/>
            <Rectangle Fill="PeachPuff" Stroke="Black" Grid.Row="2" Grid.Column="7"/>
        </Grid>
        <Label Content="Add Custom Color" ToolTip="Enter a number from 0 to 255 for each input, then click on a box."/>
        <Separator Background="Gray"/>
        <Grid Height="40" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Stroke="Black"/>
            <Rectangle Stroke="Black" Grid.Column="1"/>
            <Rectangle Stroke="Black" Grid.Column="2"/>
            <Rectangle Stroke="Black" Grid.Column="3"/>
            <Rectangle Stroke="Black" Grid.Column="4"/>
            <Rectangle Stroke="Black" Grid.Column="5"/>
            <Rectangle Stroke="Black" Grid.Column="6"/>
            <Rectangle Stroke="Black" Grid.Column="7"/>
        </Grid>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="R:"/>
            <TextBox Width="30"/>
            <TextBlock Text="G:" Margin="5,0,0,0"/>
            <TextBox Width="30"/>
            <TextBlock Text="B:" Margin="5,0,0,0"/>
            <TextBox Width="30"/>
            <Button Content="Save Color" Margin="20,0,0,0" Width="75"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Current Brush Color: "/>
            <TextBlock Text="Black"/>
        </StackPanel>

    </StackPanel>
</Window>
